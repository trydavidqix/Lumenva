{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lumenva.tool.v1",
  "type": "object",
  "required": [
    "id",
    "name",
    "tool_name",
    "source",
    "measurement_type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tool_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "health": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_seen": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "measurement_type": {
      "enum": [
        "exact",
        "estimated",
        "unavailable"
      ]
    },
    "provenance": {
      "type": [
        "object",
        "string",
        "null"
      ]
    }
  }
}
