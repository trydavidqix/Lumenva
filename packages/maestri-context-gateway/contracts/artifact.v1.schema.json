{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lumenva.artifact.v1",
  "type": "object",
  "required": [
    "artifact_id",
    "type",
    "source"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "measurement_type": {
      "enum": [
        "exact",
        "estimated",
        "unavailable"
      ]
    }
  }
}
