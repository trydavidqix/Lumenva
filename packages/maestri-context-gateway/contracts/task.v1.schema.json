{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lumenva.task.v1",
  "type": "object",
  "required": [
    "task_id",
    "status",
    "source",
    "measurement_type"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "executor": {
      "type": [
        "string",
        "null"
      ]
    },
    "risk": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "measurement_type": {
      "enum": [
        "exact",
        "estimated",
        "unavailable"
      ]
    },
    "provenance": {
      "type": [
        "object",
        "string",
        "null"
      ]
    }
  }
}
