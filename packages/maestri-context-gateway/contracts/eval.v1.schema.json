{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lumenva.eval.v1",
  "type": "object",
  "required": [
    "run_id",
    "timestamp",
    "source",
    "measurement_type"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "variant": {
      "type": [
        "string",
        "null"
      ]
    },
    "dataset": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "measurement_type": {
      "enum": [
        "exact",
        "estimated",
        "unavailable"
      ]
    },
    "provenance": {
      "type": [
        "object",
        "string",
        "null"
      ]
    }
  }
}
