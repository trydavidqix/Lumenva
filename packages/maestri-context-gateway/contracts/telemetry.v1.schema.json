{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lumenva.telemetry.v1",
  "type": "object",
  "required": [
    "timestamp",
    "source",
    "measurement_type"
  ],
  "properties": {
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool": {
      "type": [
        "string",
        "null"
      ]
    },
    "plugin": {
      "type": [
        "string",
        "null"
      ]
    },
    "mcp": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_tokens": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cached_input_tokens": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "reasoning_tokens": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "total_tokens": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "measurement_type": {
      "enum": [
        "exact",
        "estimated",
        "unavailable"
      ]
    },
    "provenance": {
      "type": [
        "object",
        "string",
        "null"
      ]
    }
  }
}
