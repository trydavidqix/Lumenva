# ops/n8n/.env.example — nomes/placeholders apenas. NENHUM valor aqui é
# credencial real. Copie para `ops/n8n/.env` (NÃO commitado — já coberto por
# .gitignore raiz de `*.env`/`.env*`) e preencha com valores reais vindos do
# cofre operacional gerido (docs/runbooks/ai-platform-secrets.md, Infisical).
#
# Detalhe operacional completo (geração de segredos, exposição pública,
# backup/restore, update, audit): docs/runbooks/n8n.md.

# --- Postgres dedicado ao n8n (NUNCA o Postgres/Supabase do CRM) ---
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
# Gere com `openssl rand -base64 32`. Nunca reutilize a senha do Postgres do CRM.
N8N_DB_PASSWORD=REPLACE_WITH_GENERATED_SECRET

# --- Chave de criptografia do n8n (credenciais/execuções armazenadas) ---
# Gere com `openssl rand -hex 32`. CRÍTICO: perder esta chave = perder acesso
# a TODA credencial salva no n8n (irrecuperável). NUNCA regenere sobre um
# volume/banco existente sem re-autenticar cada credencial manualmente —
# leia docs/runbooks/n8n.md ANTES de gerar ou rotacionar este valor.
N8N_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_SECRET

# --- Hostname/URL desta instância n8n ---
# Hostname DEDICADO — nunca reaproveitar o hostname público do WAHA/app.
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
# Porta loopback local que o proxy reverso do host encaminha (ver runbook).
N8N_LOOPBACK_PORT=5678
# URL pública usada pelo n8n para montar links de webhook. Deve bater com o
# hostname/proxy configurado — ver docs/runbooks/n8n.md antes de expor.
N8N_WEBHOOK_URL=https://n8n.example.com/
# true em produção atrás de HTTPS; só use "false" em ambiente local sem TLS.
N8N_SECURE_COOKIE=true
# Nº de hops de proxy reverso na frente do n8n (host proxy único = 1).
N8N_PROXY_HOPS=1

N8N_TIMEZONE=America/Sao_Paulo
