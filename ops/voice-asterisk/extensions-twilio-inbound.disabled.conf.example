; TEMPLATE ONLY — NOT ACTIVE. Include this context in the production dialplan only
; after the Twilio trunk and DID have been validated in a controlled window.

[voice-inbound-twilio]
; Accept only the DID selected by the owner. Do not use a catch-all Dial() target.
exten => <TWILIO_DID_E164_OR_NORMALIZED>,1,NoOp(Twilio inbound ${CALLERID(num)})
 ; Must match voice_sip_connections.external_connection_id and the outbound
 ; PJSIP endpoint name. Canonical value for this integration: twilio-outbound.
 same => n,Set(SIP_CONNECTION_ID=twilio-outbound)
 same => n,Answer()
 same => n,Stasis(voicecore-test)
 same => n,Hangup()
