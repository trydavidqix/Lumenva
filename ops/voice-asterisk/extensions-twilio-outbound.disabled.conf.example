; TEMPLATE ONLY — NOT ACTIVE.
; ARI originates PJSIP/<E164>@twilio-outbound and, after answer, sends the
; channel to context voice-outbound-twilio, extension s, priority 1.
; The ARI request sets SIP_CONNECTION_ID, VOICE_DIRECTION and VOICE_CALL_ID
; before the channel is created.

[voice-outbound-twilio]
exten => s,1,NoOp(Lumenva governed Twilio outbound)
 same => n,Stasis(voicecore-test)
 same => n,Hangup()
