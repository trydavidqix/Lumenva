# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Meta / Facebook / Instagram ─────────────────────────────────────────────
# Obtenha em https://developers.facebook.com → Seu App → Configurações Básicas
META_APP_ID=
META_APP_SECRET=

# URL base onde os callbacks OAuth serão recebidos (sem barra final)
# Em produção: https://seu-dominio.com
# Em local:    http://localhost:3001
META_REDIRECT_BASE_URL=http://localhost:3001

# Token de verificação do webhook Meta (qualquer string aleatória segura)
# Configure o mesmo valor no painel Meta → Webhooks → Verify Token
META_WEBHOOK_VERIFY_TOKEN=

# ─── Segurança de Tokens ─────────────────────────────────────────────────────
# Chave de 32 bytes (256-bit) para criptografar os access tokens da Meta no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA commite este valor. Use Secret Manager em produção.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# ─── BrightBean (opcional — necessário apenas para TikTok/YouTube) ────────────
BRIGHTBEAN_BASE_URL=
BRIGHTBEAN_API_KEY=
