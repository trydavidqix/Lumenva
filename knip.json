{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tests/**/*.{test,spec}.{ts,tsx,mts,cts,mjs,cjs,js,jsx}",
        "tooling/scripts/**/*.{ts,tsx,mts,cts,mjs,cjs,js,jsx}",
        "prettier.config.mjs"
      ],
      "project": [
        "tests/**/*.{ts,tsx,mts,cts,mjs,cjs,js,jsx}",
        "tooling/scripts/**/*.{ts,tsx,mts,cts,mjs,cjs,js,jsx}",
        "prettier.config.mjs"
      ],
      "vitest": {
        "config": []
      },
      "ignore": [
        "docs/archive/**"
      ]
    },
    "apps/crm": {
      "entry": [
        "app/**/{page,layout,route,loading,error,not-found,template,default,global-error}.{ts,tsx}",
        "scripts/**/*.{ts,tsx,mts,cts,mjs,cjs,js,jsx}",
        "workers/**/main.{ts,tsx,mts,cts,mjs,cjs,js,jsx}",
        "tests/**/*.{test,spec}.{ts,tsx,mts,cts,mjs,cjs,js,jsx}",
        "tests/{capture-*,prova-*,ataque-*}.ts",
        "tests/{sonda-*,vigia-*,compose-*}.ts",
        "tests/journeys/auth.setup.ts",
        "workers/**/*.smoke.mjs",
        "lib/agent-engine/product-agents/index.ts"
      ],
      "project": [
        "app/**/*.{ts,tsx,mts,cts,mjs,cjs,js,jsx}",
        "components/**/*.{ts,tsx,mts,cts,mjs,cjs,js,jsx}",
        "hooks/**/*.{ts,tsx,mts,cts,mjs,cjs,js,jsx}",
        "lib/**/*.{ts,tsx,mts,cts,mjs,cjs,js,jsx}",
        "scripts/**/*.{ts,tsx,mts,cts,mjs,cjs,js,jsx}",
        "tests/**/*.{ts,tsx,mts,cts,mjs,cjs,js,jsx}",
        "workers/**/*.{ts,tsx,mts,cts,mjs,cjs,js,jsx}",
        "app/**/*.css"
      ],
      "playwright": {
        "config": []
      },
      "ignoreDependencies": [
        "import-in-the-middle",
        "require-in-the-middle"
      ],
      "ignoreBinaries": [
        "ffmpeg",
        "psql"
      ],
      "ignoreIssues": {
        "tests/unit/require-platform-admin-api.test.ts": [
          "unresolved"
        ]
      }
    }
  },
  "ignoreIssues": {
    "apps/crm/lib/database.types.ts": [
      "exports",
      "types"
    ]
  },
  "rules": {
    "exports": "warn",
    "types": "warn"
  }
}
