{
  "name": "lumenva-monorepo",
  "private": true,
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.7.0"
  },
  "packageManager": "pnpm@12.7.0",
  "scripts": {
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=6144 pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "lint:channels": "pnpm -r --if-present lint:channels",
    "test:harness": "pnpm -r --if-present test:harness",
    "harness:check": "pnpm -r --if-present harness:check",
    "test:unit": "pnpm -r --if-present --no-bail test:unit",
    "test:shell": "pnpm -r --if-present test:shell",
    "test:db": "pnpm -r --if-present test:db",
    "repo:check": "node tooling/scripts/repo-check.mjs",
    "check:versions": "syncpack lint --dependency-types '!local'",
    "check:monorepo": "sherif",
    "check:dead-code": "knip",
    "check:all": "pnpm check:versions && pnpm check:monorepo && pnpm repo:check && pnpm typecheck && pnpm lint && pnpm test:unit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "cross-env": "^10.1.0",
    "knip": "catalog:",
    "sherif": "catalog:",
    "syncpack": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "js-yaml": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "stripe": "catalog:"
  }
}
